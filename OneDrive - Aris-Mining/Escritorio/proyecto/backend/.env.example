# =============================================================================
# Plantilla backend/.env — copie a .env y complete con valores reales.
# Reinicie el servidor Node tras cada cambio.
# =============================================================================

# --- Microsoft Entra ID (app registration del backend) ---
# Permisos de aplicación: User.ReadWrite.All y GroupMember.ReadWrite.All (consentimiento admin).
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

PORT=5000
NODE_ENV=development

# --- Usuarios administrativos (cola Active Directory vía carpeta SMB) ---
# Ruta UNC donde el backend escribe pendiente-{uuid}.json (el script PS en el servidor los procesa).
AD_QUEUE_UNC=\\servidor\scripts\pending
# Tiempo máximo (ms) del botón «Probar conexión» en el front (1000–120000; por defecto 8000).
AD_QUEUE_CONNECTION_TEST_TIMEOUT_MS=8000
# Dominio del correo/UPN sin @ (mismo tenant que operativos si comparten Entra ID).
AD_QUEUE_EMAIL_DOMAIN=empresa.onmicrosoft.com
# Contenedor LDAP bajo el cual cuelgan las OU por sede (Medellín, Segovia, etc.).
AD_QUEUE_OU_DN=OU=Office365Sync,OU=Usuarios,DC=empresa,DC=local
# Valor del atributo Company en Active Directory (campo empresa en el JSON de cola).
AD_QUEUE_COMPANY=Mi Empresa

# --- Grupos Microsoft 365 para usuarios operativos ---
# Por cada sede: Object ID del grupo operarios.{sede} y colaboradores.{sede} en Entra ID.
# Ejemplo de nombres en Azure: operarios.medellin, colaboradores.segovia
GROUP_OPERARIOS_MEDELLIN_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_COLABORADORES_MEDELLIN_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_OPERARIOS_SEGOVIA_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_COLABORADORES_SEGOVIA_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_OPERARIOS_MARMATO_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_COLABORADORES_MARMATO_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_OPERARIOS_BOGOTA_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_COLABORADORES_BOGOTA_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_OPERARIOS_BUCARAMANGA_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_COLABORADORES_BUCARAMANGA_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Grupos adicionales para todos los operativos (Object IDs separados por coma, mismo orden en DISPLAY_NAMES).
OPERATIONAL_COMMON_GROUP_IDS=uuid1,uuid2,uuid3
OPERATIONAL_COMMON_GROUP_DISPLAY_NAMES=Grupo Uno,Grupo Dos,Grupo Tres
