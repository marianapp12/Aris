# Azure AD / Microsoft 365 (usuarios operativos via Graph)
# Azure Portal: permisos de aplicacion User.ReadWrite.All (consentimiento admin).
# Para agregar operativos a grupos por sede: GroupMember.ReadWrite.All (consentimiento admin).
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

PORT=5000
NODE_ENV=development

# Cola SMB para usuarios administrativos (JSON en carpeta compartida).
# Node debe tener permiso de escritura en AD_QUEUE_UNC. Ver docs/server-scripts/.
AD_QUEUE_UNC=\\10.10.11.9\scripts\pending

# Prueba «Probar conexion» (SMB): tiempo maximo en ms (1000-120000). Por defecto 8000.
AD_QUEUE_CONNECTION_TEST_TIMEOUT_MS=8000

# Dominio UPN/correo administrativos (sin @), alineado con Azure AD Connect / AD
AD_QUEUE_EMAIL_DOMAIN=empresa.co

# Dominio UPN operativos en M365 (sin @). Debe ser el MISMO tenant que AD_QUEUE_EMAIL_DOMAIN en produccion:
# si difieren, el prechequeo Graph al encolar administrativos puede no detectar un operativo ya creado en M365.
OPERATIONAL_UPN_DOMAIN=empresa.co

# Por defecto NO se escriben resultado-operativo-m365-* ni .reservado-m365-* en carpetas SMB.
# Administrativos: Microsoft Graph (UPN/correo) → cola AD (pendiente/resultado) → LDAP.
# OPERATIONAL_M365_SMB_MIRROR=true solo si Graph es muy lento y necesita espejos en disco (legacy).

# Prechequeo al crear operativos (orden): carpetas SMB → Microsoft Graph → LDAP (opcional).
# Con solo AD_QUEUE_UNC y lectura SMB en pending/resultados/procesados NO hace falta contraseña en .env.
# Carpetas hermanas de pending (por defecto): \\servidor\scripts\resultados, \\servidor\scripts\procesados.
# Si resultados no es hermana de pending, defina la ruta explícita (Node y Process-AdUserQueue.ps1 deben coincidir).
# AD_QUEUE_RESULTS_UNC=\\servidor\scripts\resultados
# AD_QUEUE_PROCESSED_UNC=\\servidor\scripts\procesados

# Reintentos Graph al encolar administrativos tras un operativo en M365 (replicación Entra).
# AD_QUEUE_GRAPH_PRECHECK_RETRY_ATTEMPTS=8
# AD_QUEUE_GRAPH_PRECHECK_RETRY_DELAY_MS=2000

# No usar en produccion: omite consulta Graph al encolar administrativos (solo carpetas/LDAP).
# AD_QUEUE_SKIP_GRAPH_PRECHECK=true

# LDAP opcional: solo si las cuatro variables tienen valor (incluida contraseña). Cuenta de servicio de lectura, no Administrador.
# AD_LDAP_URL=ldap://10.10.11.4:389
# AD_LDAP_BIND_DN=CN=svc-ldap,OU=ServiceAccounts,DC=empresa,DC=local
# AD_LDAP_BIND_PASSWORD=
# AD_LDAP_SEARCH_BASE=DC=empresa,DC=local
# AD_LDAP_TLS_REJECT_UNAUTHORIZED=false
# AD_LDAP_TIMEOUT_MS=10000
# AD_LDAP_CONNECT_TIMEOUT_MS=8000

# Solo pruebas: omitir prechequeo AD/cola al elegir UPN operativo (no usar en produccion).
# OPERATIONAL_SKIP_AD_PRECHECK=true

# Contenedor LDAP para OU por sede (obligatorio para altas administrativas por sede).
AD_QUEUE_OU_DN=OU=Office365Sync,OU=Usuarios,DC=prueba,DC=local

# Atributo Company en AD (campo empresa en el JSON)
AD_QUEUE_COMPANY=Mi Empresa

# Grupos Entra ID por sede (Object ID). Tras crear el usuario operativo se agrega como miembro.
# Si falta una variable para una sede, el usuario se crea igual; solo advertencia en logs.
GROUP_MEDELLIN_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_SEGOVIA_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_MARMATO_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_BOGOTA_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_BUCARAMANGA_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Grupos comunes para todos los operativos (ademas del grupo por sede). Object IDs separados por coma.
OPERATIONAL_COMMON_GROUP_IDS=uuid1,uuid2,uuid3

# Etiquetas opcionales para la UI (mismo orden y numero que la linea anterior; sin comas dentro de cada nombre).
OPERATIONAL_COMMON_GROUP_DISPLAY_NAMES=Grupo Uno,Grupo Dos,Grupo Tres
