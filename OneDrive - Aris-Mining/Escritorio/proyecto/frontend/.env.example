# API REST (Express monta rutas bajo /api/users).
# Desarrollo con Vite (npm run dev): use /api para proxy al backend.
VITE_API_BASE_URL=/api

# Microsoft Entra ID (SPA). Registrar redirect URI del origin (ej. http://localhost:5173).
VITE_AZURE_TENANT_ID=YOUR_TENANT_ID
VITE_AZURE_CLIENT_ID=YOUR_CLIENT_ID

# Object ID del grupo permitido (autorizacion en frontend).
VITE_AZURE_LOGI_GROUP_ID=YOUR_LOGI_GROUP_OBJECT_ID

# Plantillas Excel corporativas (URL https). Si vacio, se usa public/plantilla-*.xlsx
VITE_PLANTILLA_OPERARIOS_URL=https://suempresa.sharepoint.com/.../plantilla-operarios.xlsx
VITE_PLANTILLA_ADMINISTRATIVOS_URL=https://suempresa.sharepoint.com/.../plantilla-administrativos.xlsx
